[Unit]
Description=Ollama LLM server for Abls-Habitat
Documentation=https://github.com/ollama/ollama
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/ollama/ollama:latest
ContainerName=ollama
AutoUpdate=registry
Environment=TZ=Europe/Paris
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_KEEP_ALIVE=5m
Volume=/var/lib/ollama:/root/.ollama:Z
PublishPort=127.0.0.1:11434:11434

[Service]
ExecStartPre=/usr/bin/mkdir -p /var/lib/ollama
ExecStartPost=/bin/sh -c "for i in $$(seq 1 60); do /usr/bin/podman exec ollama ollama list >/dev/null 2>&1 && break; sleep 2; done; /usr/bin/podman exec ollama ollama show qwen2.5:7b >/dev/null 2>&1 || /usr/bin/podman exec ollama ollama pull qwen2.5:7b"
Restart=always
RestartSec=10
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
